local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local currentWalkId = nil
local currentWalkTrack = nil
local currentIdleId = nil
local currentIdleTrack = nil
local humanoid, rootPart, animator
local animationPlayedConn = nil

local function clearTrack(track)
    if track then
        track:Stop(0.1)
        track:Destroy()
    end
end

local function restoreDefault()
    currentWalkId = nil
    currentIdleId = nil
    
    if currentWalkTrack then clearTrack(currentWalkTrack) currentWalkTrack = nil end
    if currentIdleTrack then clearTrack(currentIdleTrack) currentIdleTrack = nil end

    local char = player.Character
    if char then

        local animateScript = char:FindFirstChild("Animate")
        if animateScript then
            animateScript.Disabled = true
            task.wait(0.05)
            animateScript.Disabled = false
        end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, track in pairs(hum:GetPlayingAnimationTracks()) do
                track:Stop(0.1)
            end
        end
    end
end

local function setupCharacter(char)
    humanoid = char:WaitForChild("Humanoid")
    rootPart = char:WaitForChild("HumanoidRootPart")
    animator = humanoid:WaitForChild("Animator")

    if animationPlayedConn then animationPlayedConn:Disconnect() end
    animationPlayedConn = humanoid.AnimationPlayed:Connect(function(track)

        if currentWalkId or currentIdleId then
            local id = track.Animation.AnimationId
            if id:find("7815618175") or id:find("7807831448") or id:find("180435571") or id:find("180435792") then
                track:Stop(0)
            end
        end
    end)
end

player.CharacterAdded:Connect(setupCharacter)
if player.Character then setupCharacter(player.Character) end

RunService.RenderStepped:Connect(function()
    if not humanoid or not rootPart or not animator then return end
    
    local isMoving = humanoid.MoveDirection.Magnitude > 0
    
    if currentWalkId then
        if isMoving then
            if not currentWalkTrack or currentWalkTrack.Animation.AnimationId ~= currentWalkId then
                if currentWalkTrack then clearTrack(currentWalkTrack) end
                local anim = Instance.new("Animation")
                anim.AnimationId = currentWalkId
                currentWalkTrack = animator:LoadAnimation(anim)
                currentWalkTrack.Priority = Enum.AnimationPriority.Action4
                currentWalkTrack.Looped = true
            end
            
            if not currentWalkTrack.IsPlaying then
                if currentIdleTrack then currentIdleTrack:Stop(0.1) end
                currentWalkTrack:Play(0.1)
            end
            currentWalkTrack:AdjustSpeed(humanoid.WalkSpeed / 16)
        else
            if currentWalkTrack and currentWalkTrack.IsPlaying then
                currentWalkTrack:Stop(0.1)
            end
        end
    end

    if currentIdleId then
        if not isMoving then
            if not currentIdleTrack or currentIdleTrack.Animation.AnimationId ~= currentIdleId then
                if currentIdleTrack then clearTrack(currentIdleTrack) end
                local anim = Instance.new("Animation")
                anim.AnimationId = currentIdleId
                currentIdleTrack = animator:LoadAnimation(anim)
                currentIdleTrack.Priority = Enum.AnimationPriority.Action3
                currentIdleTrack.Looped = true
            end
            
            if not currentIdleTrack.IsPlaying then
                currentIdleTrack:Play(0.2)
            end
        else
            if currentIdleTrack and currentIdleTrack.IsPlaying then
                currentIdleTrack:Stop(0.2)
            end
        end
    end
end)

